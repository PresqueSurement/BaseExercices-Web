\newenvironment{DeuxCols}[1][2]{%
	
	% On incrément à chaque fois que l'on rentre
	\stepcounter{DCLS}
		
	% DeuxCols ssi SCLS=1
	\ifthenelse{\value{DCLS}>1}{}{%
	% On sauvegarde le nombre de colonnes
	% lors du premier appel
	\setcounter{DCLSnb}{#1}
	\setlength{\columnsep}{30pt}
	\setlength{\columnseprule}{.5pt}
	\begin{multicols}{#1}}
	}%
	{%
	% DeuxCols ssi SCLS=1
	\ifthenelse{\value{DCLS}>1}{}{\end{multicols}}
	
	% On décrémente à chaque sortie
	\addtocounter{DCLS}{-1}}

\newcommand{\HorsDC}[1]{%
	%On sort de enumerate niveau I
	\ifthenelse{\value{enumi}>0}{%
	\setcounter{Enumi}{\theenumi}
	\end{enumerate}}{%
	\setcounter{Enumi}{0}}
	
	%On sort des DeuxCols
	\setcounter{DCLSsave}{\theDCLS}
	\whiledo{\value{DCLS}>0}{\end{DeuxCols}}
	
	#1

	\whiledo{\value{DCLSsave}>0}{%
	\begin{DeuxCols}[\theDCLSnb]
	\addtocounter{DCLSsave}{-1}}

	%On revient dans enumerate niveau I
	\ifthenelse{\value{Enumi}>0}{%
	\begin{enumerate}
	\setcounter{enumi}{\theEnumi}}{}
	}




