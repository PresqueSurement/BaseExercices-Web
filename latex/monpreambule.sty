%tracer vite fait une parabole
% macro claude 

% ============================================================
% \parabole{signe de a}{x_S}{y_S}{taille en cm}
%
% Exemples :
% \parabole{+}{-1}{1}{4}
% \parabole{-}{1}{-1}{4}
%
% Seuls les signes de x_S et y_S sont utilisés.
% Garantit une fenêtre CARRÉE de \taille cm x \taille cm,
% équilibrée visuellement que la parabole touche/traverse
% l'axe des abscisses ou non, avec une flèche d'axe correcte.
% ============================================================
%
% Prérequis dans le préambule :
% \usepackage{tikz}
% \usetikzlibrary{arrows.meta}
% \usepackage{etoolbox}

\newcommand{\parabole}[4]{%
\begin{tikzpicture}

    \def\xS{#2}
    \def\yS{#3}
    \def\taille{#4}
    \def\borneX{2}
    \def\decalage{1}
    \def\courbure{0.65}
    \def\courbeHaut{2.65}

    % Marge quand ce côté ne contient NI axe NI courbe
    % (cas où la parabole touche/traverse l'axe horizontal)
    \def\margeVide{0.5}

    % Marge quand ce côté contient l'axe horizontal ET la pointe
    % de la flèche verticale : doit être assez généreuse pour que
    % la flèche se prolonge visiblement au-delà de l'intersection
    \def\margeAxe{1.2}

    % --------------------------------------------------------
    % Position des axes par rapport au sommet (toujours en (0,0))
    % --------------------------------------------------------

    \pgfmathsetmacro{\xO}
        {(\xS>0) ? -\decalage :
         ((\xS<0) ? \decalage : 0)}

    \pgfmathsetmacro{\yO}
        {(\yS>0) ? -\decalage :
         ((\yS<0) ? \decalage : 0)}

    \ifstrequal{#1}{+}{\def\signA{1}}{\def\signA{-1}}

    % --------------------------------------------------------
    % Fenêtre verticale "naturelle" :
    % - côté "ouverture" : toujours \courbeHaut
    % - côté opposé :
    %     * si l'axe horizontal s'y trouve réellement (pas de
    %       croisement avec la courbe) -> \margeAxe (assez pour
    %       une flèche correcte)
    %     * sinon (la courbe touche/traverse l'axe, qui est donc
    %       déjà du côté "ouverture") -> \margeVide (minimal)
    % --------------------------------------------------------

    \pgfmathsetmacro{\yTopNat}
        {(\signA>0) ? \courbeHaut :
         ((\yO>=0) ? (\yO+\margeAxe) : \margeVide)}

    \pgfmathsetmacro{\yBotNat}
        {(\signA<0) ? -\courbeHaut :
         ((\yO<=0) ? (\yO-\margeAxe) : -\margeVide)}

    % --------------------------------------------------------
    % Mise au carré de la fenêtre locale
    % --------------------------------------------------------

    \pgfmathsetmacro{\largeurNat}{2*\borneX}
    \pgfmathsetmacro{\hauteurNat}{\yTopNat - \yBotNat}
    \pgfmathsetmacro{\cote}{max(\largeurNat,\hauteurNat)}

    \pgfmathsetmacro{\extraH}{(\cote-\largeurNat)/2}
    \pgfmathsetmacro{\extraV}{(\cote-\hauteurNat)/2}

    \pgfmathsetmacro{\xGauche}{-\borneX-\extraH}
    \pgfmathsetmacro{\xDroite}{\borneX+\extraH}
    \pgfmathsetmacro{\yTop}{\yTopNat+\extraV}
    \pgfmathsetmacro{\yBot}{\yBotNat-\extraV}

    \pgfmathsetmacro{\echelle}{\taille/\cote}

    % --------------------------------------------------------
    % Dessin
    % --------------------------------------------------------

    \begin{scope}[
        x=\echelle cm,
        y=\echelle cm
    ]

        \path[use as bounding box]
            (\xGauche,\yBot)
            rectangle
            (\xDroite,\yTop);

        \draw[
            -{Stealth[length=2.5mm,width=1.5mm]},
            line width=0.6pt
        ]
            (\xGauche,\yO) -- (\xDroite,\yO);

        \draw[
            -{Stealth[length=2.5mm,width=1.5mm]},
            line width=0.6pt
        ]
            (\xO,\yBot) -- (\xO,\yTop);

        \begin{scope}
            \clip
                (\xGauche,\yBot)
                rectangle
                (\xDroite,\yTop);

            \ifstrequal{#1}{+}{%
                \draw[
                    thick,
                    domain=-\borneX:\borneX,
                    samples=100
                ]
                plot (\x,{\courbure*(\x)^2});
            }{%
                \draw[
                    thick,
                    domain=-\borneX:\borneX,
                    samples=100
                ]
                plot (\x,{-\courbure*(\x)^2});
            }

        \end{scope}

    \end{scope}

\end{tikzpicture}%
}




