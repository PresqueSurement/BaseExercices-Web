% ============================================================
% BOÎTE GÉNÉRIQUE
%
% #1 : titre
% #2 : couleur de fond
% #3 : couleur du cadre
% #4 : icône
% ============================================================

\newtcolorbox{boitecours}[4]{
  enhanced,
  breakable,
  colback=#2,
  colframe=#3,
  boxrule=0.8pt,
  arc=4mm,
  outer arc=4mm,
  left=12mm,
  right=4mm,
  top=6mm,
  bottom=4mm,
  title={#1},
  fonttitle=\bfseries,
  coltitle=#3,
  attach boxed title to top left={
    xshift=10mm,
    yshift=-\tcboxedtitleheight/2
  },
  boxed title style={
    enhanced,
    colback=#2,
    colframe=#3,
    boxrule=0.8pt,
    arc=3mm,
    outer arc=3mm,
    left=3mm,
    right=3mm,
    top=1mm,
    bottom=1mm
  },
  overlay unbroken={
    % Pictogramme
    \node[
      text=#3,
      font=\large,
      inner sep=0pt
    ]
    at ([xshift=7mm,yshift=-7mm]frame.north west)
    {#4};

    % Liseré vertical
    \draw[#3,line width=1.2pt]
      ([xshift=7mm,yshift=-11mm]frame.north west)
      --
      ([xshift=7mm,yshift=5mm]frame.south west);
  },
  before skip=7mm,
  after skip=6mm
}


